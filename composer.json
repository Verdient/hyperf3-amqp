{
    "name": "verdient/hyperf3-amqp",
    "type": "library",
    "require": {
        "doctrine/instantiator": "^1.5",
        "hyperf/amqp": "^3.1",
        "hyperf/command": "^3.1",
        "hyperf/config": "^3.1",
        "hyperf/context": "^3.1",
        "hyperf/contract": "^3.1",
        "hyperf/di": "^3.1",
        "hyperf/event": "^3.1",
        "hyperf/exception-handler": "^3.1",
        "hyperf/framework": "^3.1",
        "hyperf/logger": "^3.1",
        "hyperf/stringable": "^3.1",
        "hyperf/support": "^3.1",
        "monolog/monolog": "^3.10",
        "php-amqplib/php-amqplib": "^3.7",
        "phpdocumentor/reflection-docblock": "^6.0",
        "psr/container": "^2.0",
        "symfony/console": "^7.4",
        "verdient/cli": "^1.0",
        "verdient/hyperf3-di": "^2.0",
        "verdient/hyperf3-event": "^2.0",
        "verdient/hyperf3-exception": "^2.0",
        "verdient/hyperf3-logger": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Verdient\\Hyperf3\\Amqp\\": "src"
        }
